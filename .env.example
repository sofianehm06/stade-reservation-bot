# Token du bot Telegram, obtenu auprès de @BotFather
TELEGRAM_BOT_TOKEN=votre_token_ici

# ID Telegram numérique du gérant du stade (admin)
# Obtenu via @userinfobot (voir README.md)
ADMIN_TELEGRAM_ID=123456789

# (Production uniquement) chemin de la base sur un volume persistant.
# En local, laissez vide : la base est créée à côté du code.
# Sur Railway avec un volume monté sur /data :
# DATABASE_PATH=/data/reservations.db
